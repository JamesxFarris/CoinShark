# === CoinShark Configuration ===

# Your Solana wallet private key (base58 encoded)
# NEVER share this or commit the real .env file
SOLANA_PRIVATE_KEY=

# Solana RPC endpoint (use a paid provider for production)
# Free: https://api.mainnet-beta.solana.com (rate-limited)
# Paid: QuickNode, Helius, Chainstack, etc.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PumpPortal API key (get one at https://pumpportal.fun)
PUMPPORTAL_API_KEY=

# === Trading Settings ===

# Max SOL to spend per trade
MAX_BET_SOL=0.05

# Max number of concurrent positions
MAX_POSITIONS=3

# Slippage tolerance (percent)
SLIPPAGE_PERCENT=25

# Priority fee in SOL for faster transactions
PRIORITY_FEE_SOL=0.001

# === Take Profit / Stop Loss ===

# Take profit at this % gain (sells 50% of position)
TAKE_PROFIT_1_PERCENT=50

# Second take profit (sells remaining)
TAKE_PROFIT_2_PERCENT=100

# Stop loss at this % loss
STOP_LOSS_PERCENT=30

# === Scam Filter Thresholds ===

# Skip tokens where top 10 holders own more than this %
MAX_TOP_HOLDER_PERCENT=50

# Minimum number of unique holders before considering a buy
MIN_UNIQUE_HOLDERS=10

# Skip tokens with mint authority still enabled
REQUIRE_MINT_REVOKED=true

# Skip tokens with freeze authority still enabled
REQUIRE_FREEZE_REVOKED=true

# Minimum token age in seconds before buying (avoid sniping into scams)
MIN_TOKEN_AGE_SECONDS=30

# === KOL Tracking ===

# Comma-separated list of KOL wallet addresses to track
KOL_WALLETS=

# Minimum number of KOL wallets that must buy before we consider it a signal
MIN_KOL_BUYS=1

# === Volume/Momentum Thresholds ===

# Minimum 5-minute volume in SOL to trigger interest
MIN_5M_VOLUME_SOL=5

# Minimum number of unique buyers in last 5 minutes
MIN_5M_BUYERS=10

# Minimum market cap in SOL
MIN_MARKET_CAP_SOL=10

# Maximum market cap in SOL (avoid buying tops)
MAX_MARKET_CAP_SOL=500
