# === CoinShark Configuration ===

# Your Solana wallet private key (base58 encoded)
# NEVER share this or commit the real .env file
SOLANA_PRIVATE_KEY=

# Solana RPC endpoint
# RECOMMENDED: Sign up free at https://helius.dev (1M credits/mo, 10 RPS)
#   Your URL will look like: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# FALLBACK: https://api.mainnet-beta.solana.com (heavily rate-limited, not for bots)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# PumpPortal API key (get one at https://pumpportal.fun)
PUMPPORTAL_API_KEY=

# === Trading Settings ===

# Max SOL to spend per trade
MAX_BET_SOL=0.05

# Max number of concurrent positions
MAX_POSITIONS=3

# Slippage tolerance (percent)
SLIPPAGE_PERCENT=25

# Priority fee in SOL for faster transactions
PRIORITY_FEE_SOL=0.001

# === Take Profit / Stop Loss ===

# Take profit at this % gain (sells 50% of position)
TAKE_PROFIT_1_PERCENT=50

# Second take profit (sells remaining)
TAKE_PROFIT_2_PERCENT=100

# Stop loss at this % loss
STOP_LOSS_PERCENT=30

# === Scam Filter Thresholds ===

# Skip tokens where top 10 holders own more than this %
MAX_TOP_HOLDER_PERCENT=50

# Minimum number of unique holders before considering a buy
MIN_UNIQUE_HOLDERS=10

# Skip tokens with mint authority still enabled
REQUIRE_MINT_REVOKED=true

# Skip tokens with freeze authority still enabled
REQUIRE_FREEZE_REVOKED=true

# Minimum token age in seconds before buying (avoid sniping into scams)
MIN_TOKEN_AGE_SECONDS=30

# === KOL Tracking ===

# Comma-separated list of KOL wallet addresses to track
# These 25 are from the Dune "Top Solana Memecoin Traders" dashboard (kolscan.io)
KOL_WALLETS=AbcX4XBm7DJ3i9p29i6sU8WLmiW4FWY5tiwB9D6UBbcE,215nhcAHjQQGgwpQSJQ7zR26etbjjtVdW74NLzwEgQjP,2YJbcB9G8wePrpVBcT31o8JEed6L3abgyCjt5qkJMymV,CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o,EaVboaPxFCYanjoNWdkxTbPvt57nhXGu5i6m9m6ZS2kK,8MaVa9kdt3NW4Q5HyNAm1X5LbR8PQRVDc1W8NMVK88D5,DfMxre4cKmvogbLrPigxmibVTTQDuzjdXojWzjCXXhzj,HtucFepgUkMpHdrYsxMqjBNN6qVBdjmFaLZneNXopuJm,2kv8X2a9bxnBM8NKLc6BBTX2z13GFNRL4oRotMUJRva9,F72vY99ihQsYwqEDCfz7igKXA5me6vN2zqVsVUTpw6qL,E33jP6RWVpGkv3fDVbuR5Ee6ak42tTKW9yYszqERtobs,3h65MmPZksoKKyEpEjnWU2Yk2iYT5oZDNitGy5cTaxoE,4BdKaxN8G6ka4GYtQQWk4G4dZRUTX2vQH9GcXdBREFUk,BTf4A2exGK9BCVDNzy65b9dUzXgMqB4weVkvTMFQsadd,BCnqsPEtA1TkgednYEebRpkmwFRJDCjMQcKZMMtEdArc,GJA1HEbxGnqBhBifH9uQauzXSB53to5rhDrzmKxhSU65,7iabBMwmSvS4CFPcjW2XYZY53bUCHzXjCFEFhxeYP4CY,831qmkeGhfL8YpcXuhrug6nHj1YdK3aXMDQUCo85Auh1,96sErVjEN7LNJ6Uvj63bdRWZxNuBngj56fnT9biHLKBf,7tiRXPM4wwBMRMYzmywRAE6jveS3gDbNyxgRrEoU6RLA,EHg5YkU2SZBTvuT87rUsvxArGp3HLeye1fXaSDfuMyaf,AJ6MGExeK7FXmeKkKPmALjcdXVStXYokYNv9uVfDRtvo,73LnJ7G9ffBDjEBGgJDdgvLUhD5APLonKrNiHsKDCw5B,JDd3hy3gQn2V982mi1zqhNqUw1GfV2UL6g76STojCJPN,99i9uVA7Q56bY22ajKKUfTZTgTeP5yCtVGsrG9J4pDYQ

# Minimum number of KOL wallets that must buy before we consider it a signal
MIN_KOL_BUYS=1

# === Volume/Momentum Thresholds ===

# Minimum 5-minute volume in SOL to trigger interest
MIN_5M_VOLUME_SOL=5

# Minimum number of unique buyers in last 5 minutes
MIN_5M_BUYERS=10

# Minimum market cap in SOL
MIN_MARKET_CAP_SOL=10

# Maximum market cap in SOL (avoid buying tops)
MAX_MARKET_CAP_SOL=500

# === Bonding Curve ===

# Minimum bonding curve completion % to consider buying (too early = risky)
MIN_BONDING_CURVE_PERCENT=5

# Maximum bonding curve % (avoid buying near graduation — exit liquidity risk)
MAX_BONDING_CURVE_PERCENT=85

# === Risk Management ===

# Auto-sell positions older than this (minutes). 0 = disabled
MAX_POSITION_AGE_MINUTES=30

# Stop auto-trading after losing this much SOL in a day. 0 = disabled
DAILY_LOSS_LIMIT_SOL=0.5

# === Telegram Bot ===
# Create a bot via @BotFather on Telegram, then get your chat ID from @userinfobot

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=
